{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/hook.mjs\" sessionStart", "timeout": 15 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/hook.mjs\" userPromptSubmitted", "timeout": 10 }] }],
    "PostToolUse": [{ "matcher": "Bash|shell|.*inbox_(add|resolve|list|command|view|app_action)", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/hook.mjs\" postToolUse", "timeout": 15 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/hook.mjs\" agentStop", "timeout": 10 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/hook.mjs\" sessionEnd", "timeout": 10 }] }]
  }
}
